class Solution {
public:
    bool isValidSudoku(vector<vector<char>>& board) {
        bool row[9][9] = {};   // row[r][d]: digit d already seen in row r
        bool col[9][9] = {};   // col[c][d]: digit d already seen in column c
        bool box[9][9] = {};   // box[b][d]: digit d already seen in box b

        for (int r = 0; r < 9; r++) {
            for (int c = 0; c < 9; c++) {
                if (board[r][c] == '.') continue;

                int d = board[r][c] - '1';        // map '1'..'9' to 0..8
                int b = (r / 3) * 3 + (c / 3);    // box index 0..8

                if (row[r][d] || col[c][d] || box[b][d]) return false;

                row[r][d] = col[c][d] = box[b][d] = true;
            }
        }
        return true;
    }
};
