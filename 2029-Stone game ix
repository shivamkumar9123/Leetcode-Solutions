class Solution {
public:
    bool stoneGameIX(vector<int>& stones) {
         // Count frequencies of remainders modulo 3
        int count[3]={0,0,0};
        for(int stone:stones){
            count[stone%3]++;
        }
        // Case 1: Even number of 0-remainder stones
        if (count[0] % 2 == 0) {
            // Alice wins if both type 1 and type 2 stones are available
            return count[1] > 0 && count[2] > 0;
        }
        // Case 2: Odd number of 0-remainder stones
        // Alice wins if the absolute difference between type 1 and type 2 is greater than 2
        return abs(count[1] - count[2]) > 2;
    }
};
