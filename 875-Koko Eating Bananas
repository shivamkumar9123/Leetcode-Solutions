class Solution {
public:
    int minEatingSpeed(vector<int>& piles, int h) {   // ← name must be this
        int left = 1;
        int right = *max_element(piles.begin(), piles.end());

        while (left < right) {
            int k = left + (right - left) / 2;
            long long hours = 0;

            for (int pile : piles) {
                hours += (pile + (long long)k - 1) / k;  // ← fixed overflow
            }

            if (hours <= h) {
                right = k;
            } else {
                left = k + 1;
            }
        }
        return left;
    }
};
