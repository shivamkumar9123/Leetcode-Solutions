class Solution {
public:
    vector<vector<int>> subsets(vector<int>& nums) {
        vector<vector<int>>res={{}};
        for(int s:nums){
            int n=res.size();
            for(int i=0;i<n;i++){
                vector<int> m=res[i];
                m.push_back(s);
                res.push_back(m);
            }
        }
        return res;
        
    }
};
