class Solution {
public:
    bool isPalindrome(string s) {
        int left = 0;
        int right = s.length() - 1;

        while (left < right) {
            // left pointer ko alphanumeric char tak aage badhao
            while (left < right && !isalnum(s[left])) {
                left++;
            }
            // right pointer ko alphanumeric char tak peeche lao
            while (left < right && !isalnum(s[right])) {
                right--;
            }

            if (tolower(s[left]) != tolower(s[right])) {
                return false;
            }

            left++;
            right--;
        }

        return true;
    }
};
