class Solution {
public:
        int getNext(int n){
         int sum=0;
         while(n>0){
            int digit=n%10;
            sum=sum+digit*digit;
            n=n/10;
         }
         return sum;
        }
        bool isHappy(int n) {
        // unordered_set<int> seen;
        
        // while (n != 1 && !seen.count(n)) {
        //     seen.insert(n);
        //     n = getNext(n);
        // }
        // return n==1;
        int slow=n;
        int fast=getNext(n);
        while(fast !=1 && slow !=fast){
            slow=getNext(slow);
            fast=getNext(getNext(fast));

        }
        return fast==1;
    }
    };
