class Solution {
public:
    int countRatioSubarrays(vector<int>& nums, int a, int b) {
        int n=nums.size();

        long long valid_count_Subarray=0;

        for(int i=0;i<n;i++){

            int even_count=0;

            int odd_count=0;

        for(int j=i;j<n;j++){

            if(nums[j]%2==0){

                even_count++;
            }
            else{
                odd_count++;
            }
             if (odd_count > 0 && (long long)even_count* b <= (long long)odd_count * a) {

                valid_count_Subarray++;
            }
          }
        }
        return valid_count_Subarray;
    }
};
